### Get Member Info - USD_Reporting

GET https://{{server}}/HyperionPlanning/rest/v3/applications/{{app}}/dimensions/Currency/members/USD_Reporting
Authorization: {{creds}}
Accept: application/json

### Export Data Slice - From_USD, has data

POST https://{{server}}/HyperionPlanning/rest/v3/applications/{{app}}/plantypes/{{cube}}/exportdataslice
Authorization: {{creds}}
Accept: application/json
Content-Type: application/json

{
  "exportPlanningData": false,
  "gridDefinition": {
    "suppressMissingBlocks": false,
    "suppressMissingRows": false,
    "suppressMissingColumns": false,
    "pov": {
      "dimensions": null,
      "members": [
        [
          "From_USD"
        ]
      ]
    },
    "columns": [
      {
        "dimensions": [
          "Account",
          "Entity",
          "View"
        ],
        "members": [
          [
            "Average Rate"
          ],
          [
            "FCCS_Global Assumptions"
          ],
          [
            "FCCS_Periodic"
          ]
        ]
      }
    ],
    "rows": [
      {
        "dimensions": [
          "Years",
          "Scenario",
          "Period",
          "Currency"
        ],
        "members": [
          [
            "FY15"
          ],
          [
            "Actual"
          ],
          [
            "Jan"
          ],
          [
            "USD_Reporting"
          ]
        ]
      }
    ]
  }
}